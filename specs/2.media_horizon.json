{"description": "2. Changes in weekly viewing - Horizon chart",
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "chart": "media-horizon",
    "explanations": {
      "READ_ME": "These are explanatory notes, not rendering instructions. Search WHAT or WHY. The chart code follows below.",
      "chart_number": 2,
      "source_file": "specs/2.media_horizon.json",
      "WHAT": "Horizon chart: layered area bands show change from the first year of each series.",
      "WHY": "Folding change into 10-point bands lets several trends fit into separate compact rows.",
      "data_preparation_and_limits": "Python already calculated current percentage minus starting percentage and the band heights. Vega-Lite does not normalise the source here. Short-form video starts later than the other series.",
      "features": {
        "data": {
          "WHAT": "Load a table, geographic file or inline records.",
          "WHY": "Keep source measurements separate from the instructions that draw them."
        },
        "parse": {
          "WHAT": "Read the listed CSV columns as numbers.",
          "WHY": "Numerical comparisons and calculations must not treat values as text."
        },
        "mark": {
          "WHAT": "Choose the graphical shape: rectangle, line, point, text, rule, tick, bar or geoshape.",
          "WHY": "The mark should support the comparison this chart is designed to show."
        },
        "encoding": {
          "WHAT": "Map data fields to position, colour, size, text and other visual properties.",
          "WHY": "The viewer needs a consistent visual meaning for each measurement or category."
        },
        "layer": {
          "WHAT": "Draw several sets of marks in the same plot.",
          "WHY": "This combines data marks with labels, reference ticks and explanatory annotations."
        },
        "field": {
          "WHAT": "Read a named column from each data row.",
          "WHY": "This connects the source data or a derived field to the visual property."
        },
        "domain": {
          "WHAT": "Set the input bounds or categories of a scale.",
          "WHY": "This controls the display mapping; a domain of 0-100 does NOT normalise the data."
        },
        "range": {
          "WHAT": "Set the visual outputs of a scale, such as colours or symbol sizes.",
          "WHY": "The domain's values need corresponding visual appearances."
        },
        "tooltip": {
          "WHAT": "List the fields shown when pointing at a mark.",
          "WHY": "Exact values and context are available without permanently crowding the plot."
        },
        "filter": {
          "WHAT": "Keep only rows whose expression is true; datum means the current row.",
          "WHY": "The selected format or annotation needs a subset of the data, not a change to its values."
        },
        "calculate": {
          "WHAT": "Evaluate an expression and store its result under the name in as.",
          "WHY": "Derived coordinates and labels prepare data for display without replacing source fields."
        },
        "format": {
          "WHAT": "Choose file parsing or numeric display formatting, depending on its location.",
          "WHY": "For labels, .0f shows whole numbers and .1f one decimal; this does not replace the stored value."
        },
        "config": {
          "WHAT": "Set shared fonts, axes, legends and background styling.",
          "WHY": "Consistent presentation keeps attention on the data rather than unnecessary decoration."
        }
      }
    }
  },
  "width": "container",
  "height": 680,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#d9ded8",
      "gridOpacity": 0.65,
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 14,
      "labelPadding": 7,
      "tickColor": "#a8b3ad",
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 650,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 13,
      "symbolStrokeWidth": 3,
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 11
    },
    "header": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "titleColor": "#10231f",
      "titleFont": "Inter"
    }
  },
  "data": {
    "url": "data/horizon_trends.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "metric_order": "number",
        "baseline": "number",
        "percent": "number",
        "change": "number",
        "band": "number",
        "band_value": "number",
        "y0": "number",
        "y1": "number"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.band === 1"
        },
        {
          "calculate": "datum.change < 0 ? -datum.band : datum.band",
          "as": "signed_band"
        }
      ],
      "mark": {
        "type": "area",
        "orient": "vertical"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2017,
              2025
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "format": "d",
            "tickMinStep": 1,
            "grid": false
          }
        },
        "y": {
          "field": "y1",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              52
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y0"
        },
        "detail": {
          "field": "metric"
        },
        "color": {
          "field": "signed_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              -4,
              -3,
              -2,
              -1,
              1,
              2,
              3,
              4
            ],
            "range": [
              "#942c4d",
              "#b44062",
              "#d9859e",
              "#f0c3d0",
              "#bcd8ca",
              "#79ad99",
              "#40856f",
              "#155641"
            ]
          },
          "legend": {
            "title": [
              "Change since first year shown",
              "(percentage points)"
            ],
            "titleLimit": 290,
            "orient": "top",
            "columns": 4,
            "symbolType": "square",
            "labelExpr": "datum.value < 0 ? format(datum.value * 10, '+d') + ' to ' + format((datum.value + 1) * 10, '+d') : format((datum.value - 1) * 10, '+d') + ' to ' + format(datum.value * 10, '+d')"
          }
        },
        "tooltip": [
          {
            "field": "metric",
            "title": "Activity"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "change",
            "type": "quantitative",
            "format": "+.1f",
            "title": "Change (percentage points)"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "format": ".1f",
            "title": "Weekly use (%)"
          }
        ]
      },
      "description": "WHAT: Draw the first 10-point band. WHY: It provides the base band before higher changes are folded over it."
    },
    {
      "transform": [
        {
          "filter": "datum.band === 2"
        },
        {
          "calculate": "datum.change < 0 ? -datum.band : datum.band",
          "as": "signed_band"
        }
