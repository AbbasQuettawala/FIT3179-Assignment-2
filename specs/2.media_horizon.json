            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "format": "d",
            "tickMinStep": 1,
            "grid": false
          }
        },
        "y": {
          "field": "y1",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
