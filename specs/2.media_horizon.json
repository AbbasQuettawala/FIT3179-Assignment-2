            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y0"
        },
        "detail": {
          "field": "metric"
        },
        "color": {
          "field": "signed_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              -4,
