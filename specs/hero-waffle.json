{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#d9ded8",
      "gridOpacity": 0.65,
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 14,
      "labelPadding": 7,
      "tickColor": "#a8b3ad",
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 650,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 13,
      "symbolStrokeWidth": 3,
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 11
    },
    "header": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "titleColor": "#10231f",
      "titleFont": "Inter"
    }
  },
  "description": "100 video tiles represent Australian adults. 95 filled tiles show the rounded share who used online video in the six months before the 2025 survey. Outlined tiles show the remaining share.",
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "step": 1,
      "as": "cell"
    }
  },
  "transform": [
    {
      "calculate": "datum.cell % 10",
      "as": "column"
    },
    {
      "calculate": "floor(datum.cell / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.cell < 95 ? 'Used online video' : 'Remaining adults'",
      "as": "group"
    },
    {
      "calculate": "datum.cell < 95 ? 95 : 5",
      "as": "share"
    }
  ],
  "layer": [
    {
      "name": "hero_tiles",
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "strokeWidth": 1,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "column",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "type": "band",
            "padding": 0.15
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "type": "band",
            "padding": 0.15,
            "range": [
              95,
              {
                "expr": "height"
              }
            ]
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Used online video",
              "Remaining adults"
            ],
            "range": [
              "#1f6f5b",
              "#f7f3e8"
            ]
          },
          "legend": {
            "title": "One tile = 1 in 100 adults (rounded)",
            "titleLimit": 300,
            "orient": "bottom",
            "columns": 1,
            "symbolType": "square",
            "symbolStrokeColor": "#63736f"
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.cell < 95",
            "value": "#1f6f5b"
          },
          "value": "#63736f"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of adults (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "name": "hero_play_icons",
      "transform": [
        {
          "filter": "datum.cell < 95"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-right",
        "filled": true,
        "color": "white",
        "opacity": 1,
        "size": {
          "expr": "pow(min(width / 35, (height - 95) / 18), 2)"
        }
      },
      "encoding": {
        "x": {
          "field": "column",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of adults (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "name": "hero_total",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "text": "95 in 100",
        "font": "Fraunces",
        "fontSize": {
          "expr": "width < 360 ? 28 : 36"
        },
        "fontWeight": 700,
        "align": "left",
        "baseline": "top",
        "color": "#1f6f5b"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        }
      }
    },
    {
      "name": "hero_context",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "text": "used online video in the past six months",
        "font": "Inter",
        "fontSize": {
          "expr": "width < 360 ? 11 : 13"
        },
        "align": "left",
        "baseline": "top",
        "color": "#10231f"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 55
        }
      }
    }
  ]
}
