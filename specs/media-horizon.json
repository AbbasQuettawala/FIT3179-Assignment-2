          },
          {
            "field": "percent",
            "type": "quantitative",
            "format": ".1f",
            "title": "Weekly use (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.band === 3"
        },
        {
          "calculate": "datum.change < 0 ? -datum.band : datum.band",
          "as": "signed_band"
        }
      ],
      "mark": {
