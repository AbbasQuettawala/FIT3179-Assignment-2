{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 470,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#d9ded8",
      "gridOpacity": 0.65,
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelPadding": 7,
      "tickColor": "#a8b3ad",
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 650,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 11,
      "symbolStrokeWidth": 3,
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 11
    },
    "header": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "titleColor": "#10231f",
      "titleFont": "Inter"
    }
  },
  "description": "Unique physical sites with issued AM and/or FM licences.",
  "params": [
    {
      "name": "mapRegion",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Australia",
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth"
        ],
        "name": "Map view  "
      }
    },
    {
      "name": "stateFocus",
      "value": "All"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": {
      "expr": "mapRegion === 'Sydney' ? [-151,0,0] : mapRegion === 'Melbourne' ? [-145,0,0] : mapRegion === 'Brisbane' ? [-153,0,0] : mapRegion === 'Perth' ? [-116,0,0] : [-134,0,0]"
    },
    "center": {
      "expr": "mapRegion === 'Sydney' ? [0,-33.8] : mapRegion === 'Melbourne' ? [0,-37.8] : mapRegion === 'Brisbane' ? [0,-27.4] : mapRegion === 'Perth' ? [0,-31.9] : [0,-28]"
    },
    "scale": {
      "expr": "mapRegion === 'Australia' ? min(width * 1.38, height * 1.45) : min(width,height) * 27"
    },
    "translate": {
      "expr": "[width/2,height/2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "clip": true,
        "fill": "#e5ebe5",
        "stroke": "#b9c7be",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/radio_sites.csv",
        "format": {
          "type": "csv",
          "parse": {
            "site_id": "number",
            "longitude": "number",
            "latitude": "number",
            "am": "number",
            "fm": "number",
            "dr": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "clip": true,
        "stroke": "#f7f3e8",
        "strokeWidth": 0.7,
        "size": 22
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Licensed site"
          },
          {
            "field": "site_id",
            "title": "ACMA site ID"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "am",
            "type": "quantitative",
            "title": "AM assignments"
          },
          {
            "field": "fm",
            "type": "quantitative",
            "title": "FM assignments"
          }
        ],
        "color": {
          "field": "technology",
          "type": "nominal",
          "scale": {
            "domain": [
              "AM",
              "FM",
              "AM + FM"
            ],
            "range": [
              "#d94d72",
              "#5279be",
              "#1f6f5b"
            ]
          },
          "legend": {
            "title": "One dot = one site",
            "orient": "top"
          }
        },
        "opacity": {
          "condition": {
            "test": "stateFocus === 'All' || datum.state === stateFocus",
            "value": 1
          },
          "value": 0.22
        }
      }
    },
    {
      "name": "state_label_pointer",
      "data": {
        "url": "data/adii_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "score": "number",
            "national": "number",
            "gap": "number",
            "absolute_gap": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.state === 'ACT'"
        },
        {
          "filter": "mapRegion === 'Australia'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 0.8,
        "color": "#10231f"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "datum": 151.9
        },
        "latitude2": {
          "datum": -35.9
        },
        "opacity": {
          "condition": {
            "test": "stateFocus === 'All' || datum.state === stateFocus",
            "value": 1
          },
          "value": 0.22
        }
      }
    },
    {
      "data": {
        "url": "data/adii_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "score": "number",
            "national": "number",
            "gap": "number",
            "absolute_gap": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.state === 'ACT' ? 153.2 : datum.longitude",
          "as": "label_longitude"
        },
        {
          "calculate": "datum.state === 'ACT' ? -35.9 : datum.latitude",
          "as": "label_latitude"
        },
        {
          "filter": "mapRegion === 'Australia'"
        },
        {
          "filter": "mapRegion === 'Australia'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State / territory"
          }
        ],
        "opacity": {
          "condition": {
            "test": "stateFocus === 'All' || datum.state === stateFocus",
            "value": 1
          },
          "value": 0.22
        }
      },
      "name": "state_label_halos",
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "stroke": "#f7f3e8",
        "strokeWidth": 3,
        "color": "#f7f3e8"
      }
    },
    {
      "data": {
        "url": "data/adii_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "score": "number",
            "national": "number",
            "gap": "number",
            "absolute_gap": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.state === 'ACT' ? 153.2 : datum.longitude",
          "as": "label_longitude"
        },
        {
          "calculate": "datum.state === 'ACT' ? -35.9 : datum.latitude",
          "as": "label_latitude"
        },
        {
          "filter": "mapRegion === 'Australia'"
        },
        {
          "filter": "mapRegion === 'Australia'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State / territory"
          }
        ],
        "opacity": {
          "condition": {
            "test": "stateFocus === 'All' || datum.state === stateFocus",
            "value": 1
          },
          "value": 0.22
        }
      },
      "name": "state_labels",
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#10231f"
      }
    },
    {
      "name": "context_city_label",
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "filter": "mapRegion !== 'Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "top",
        "color": "#10231f",
        "text": {
          "expr": "mapRegion + ' area · licensed sites'"
        }
      },
      "encoding": {
        "x": {
          "value": 6
        },
        "y": {
          "value": 6
        }
      }
    }
  ]
}
