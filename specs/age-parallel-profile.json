{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 620,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#d9ded8",
      "gridOpacity": 0.65,
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 14,
      "labelPadding": 7,
      "tickColor": "#a8b3ad",
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 650,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 13,
      "symbolStrokeWidth": 3,
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 11
    },
    "header": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "titleColor": "#10231f",
      "titleFont": "Inter"
    },
    "axisX": {
      "grid": false
    }
  },
  "description": "Choose an age group to follow its line across six weekly viewing and listening activities.",
  "data": {
    "url": "data/age_media.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "percent": "number",
        "base_n": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof([\"Paid video\", \"Short-form video\", \"Music streaming\", \"Podcasts\", \"Free-to-air TV\", \"FM radio\"], datum.metric)",
      "as": "metric_position"
    }
  ],
  "params": [
    {
      "name": "selectedAge",
      "value": "18–24",
      "bind": {
        "input": "select",
        "options": [
          "18–24",
          "25–34",
          "35–44",
          "45–54",
          "55–64",
          "65–74",
          "75+"
        ],
        "name": "Age group  "
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 72
        }
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Paid video",
            "Short-form video",
            "Music streaming",
            "Podcasts",
            "Free-to-air TV",
            "FM radio"
          ],
          "axis": {
            "title": null,
            "labelAngle": -28,
            "labelLimit": 110
          }
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              {
                "expr": "height"
              },
              100
            ]
          },
          "axis": {
            "title": "Used in past week (%)"
          }
        },
        "detail": {
          "field": "age"
        },
        "color": {
          "condition": {
            "test": "datum.age === selectedAge",
            "value": "#d94d72"
          },
          "value": "#63736f"
        },
        "opacity": {
          "condition": {
            "test": "datum.age === selectedAge",
            "value": 1
          },
          "value": 0.16
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.age === selectedAge",
            "value": 4
          },
          "value": 1.2
        },
        "order": {
          "field": "metric_position",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "age",
            "title": "Age"
          },
          {
            "field": "metric",
            "title": "Activity"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "format": ".1f",
            "title": "Used (%)"
          }
        ]
      }
    },
    {
      "name": "callout_leader",
      "transform": [
        {
          "filter": "datum.age === selectedAge"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "callout_rank"
            }
          ],
          "sort": [
            {
              "field": "percent",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.callout_rank === 1"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#63736f",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Paid video",
            "Short-form video",
            "Music streaming",
            "Podcasts",
            "Free-to-air TV",
            "FM radio"
          ]
        },
        "y": {
          "field": "percent",
          "type": "quantitative"
        },
        "x2": {
          "value": {
            "expr": "min(width * 0.8, 280)"
          }
        },
        "y2": {
          "value": {
            "expr": "10 + 15 * length(split(((datum.metric === 'Free-to-air TV') ? (width < 360 ? \"Free-to-air TV leads for this\\nage group. Online media still\\nhas users here, so older\\naudiences are not all\\noffline.\" : \"Free-to-air TV leads for this age group. Online media\\nstill has users here, so older audiences are not all\\noffline.\") : (width < 360 ? \"Paid video is most common at\\nthis age. TV and radio still\\nhave users, so these habits\\nare not all online.\" : \"Paid video is most common at this age. TV and radio still\\nhave users, so these habits are not all online.\")), '\\n'))"
          }
        },
        "tooltip": {
          "value": null
        }
      }
    },
    {
      "name": "callout_text",
      "transform": [
        {
          "filter": "datum.age === selectedAge"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "callout_rank"
            }
          ],
          "sort": [
            {
              "field": "percent",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.callout_rank === 1"
        }
      ],
      "mark": {
        "type": "text",
        "text": {
          "expr": "(datum.metric === 'Free-to-air TV') ? (width < 360 ? \"Free-to-air TV leads for this\\nage group. Online media still\\nhas users here, so older\\naudiences are not all\\noffline.\" : \"Free-to-air TV leads for this age group. Online media\\nstill has users here, so older audiences are not all\\noffline.\") : (width < 360 ? \"Paid video is most common at\\nthis age. TV and radio still\\nhave users, so these habits\\nare not all online.\" : \"Paid video is most common at this age. TV and radio still\\nhave users, so these habits are not all online.\")"
        },
        "font": "Inter",
        "fontSize": 11,
        "lineHeight": 15,
        "lineBreak": "\n",
        "align": "left",
        "baseline": "top",
        "color": "#10231f"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 5
        },
        "tooltip": {
          "value": null
        }
      }
    }
  ]
}
