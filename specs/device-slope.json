{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 470,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#d9ded8",
      "gridOpacity": 0.65,
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelPadding": 7,
      "tickColor": "#a8b3ad",
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 650,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "labelFontSize": 11,
      "symbolStrokeWidth": 3,
      "titleColor": "#10231f",
      "titleFont": "Inter",
      "titleFontSize": 11
    },
    "header": {
      "labelColor": "#10231f",
      "labelFont": "Inter",
      "titleColor": "#10231f",
      "titleFont": "Inter"
    },
    "axisX": {
      "grid": false
    }
  },
  "description": "A slopegraph showing how online video devices changed between 2021 and 2025.",
  "data": {
    "url": "data/video_devices.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.7
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": 700
          }
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "axis": {
            "title": "Use for online video at home (%)"
          },
          "scale": {
            "range": [
              {
                "expr": "height"
              },
              100
            ]
          }
        },
        "detail": {
          "field": "device"
        },
        "color": {
          "field": "device",
          "type": "nominal",
          "scale": {
            "range": [
              "#24665a",
              "#914859",
              "#355f91",
              "#854689",
              "#946218",
              "#496a31",
              "#9f4329",
              "#536069"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "device",
            "title": "Device"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 85
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "range": [
              {
                "expr": "height"
              },
              100
            ]
          }
        },
        "color": {
          "field": "device",
          "type": "nominal",
          "scale": {
            "range": [
              "#24665a",
              "#914859",
              "#355f91",
              "#854689",
              "#946218",
              "#496a31",
              "#9f4329",
              "#536069"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        },
        {
          "calculate": "(datum.device === 'Chromecast / Google TV' ? 'Google TV' : datum.device === 'Games console' ? 'Console' : datum.device) + ' ' + format(datum.percent, '.0f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "dy": {
          "expr": "datum.device === 'Games console' ? -5 : datum.device === 'Apple TV' ? 5 : 0"
        },
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 650
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "range": [
              {
                "expr": "height"
              },
              100
            ]
          }
        },
        "text": {
          "field": "label"
        },
        "color": {
          "field": "device",
          "type": "nominal",
          "scale": {
            "range": [
              "#24665a",
              "#914859",
              "#355f91",
              "#854689",
              "#946218",
              "#496a31",
              "#9f4329",
              "#536069"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "name": "callout_leader",
      "transform": [
        {
          "filter": "datum.year === 2025 && datum.device === 'Smart TV'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#63736f",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "percent",
          "type": "quantitative"
        },
        "x2": {
          "value": {
            "expr": "min(width * 0.8, 280)"
          }
        },
        "y2": {
          "value": {
            "expr": "10 + 15 * length(split((width < 360 ? \"Smart TVs gain more than\\nphones here: online video is\\nalso a living-room habit, not\\njust a mobile one.\" : \"Smart TVs gain more than phones here: online video is also\\na living-room habit, not just a mobile one.\"), '\\n'))"
          }
        },
        "tooltip": {
          "value": null
        }
      }
    },
    {
      "name": "callout_text",
      "transform": [
        {
          "filter": "datum.year === 2025 && datum.device === 'Smart TV'"
        }
      ],
      "mark": {
        "type": "text",
        "text": {
          "expr": "width < 360 ? \"Smart TVs gain more than\\nphones here: online video is\\nalso a living-room habit, not\\njust a mobile one.\" : \"Smart TVs gain more than phones here: online video is also\\na living-room habit, not just a mobile one.\""
        },
        "font": "Inter",
        "fontSize": 11,
        "lineHeight": 15,
        "lineBreak": "\n",
        "align": "left",
        "baseline": "top",
        "color": "#10231f"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 5
        },
        "tooltip": {
          "value": null
        }
      }
    }
  ]
}
